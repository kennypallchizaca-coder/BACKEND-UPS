{
  "kind": "collectionType",
  "collectionName": "publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Publicación",
    "description": "Administra noticias, eventos, logros y proyectos de la sección Vive la carrera."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "Noticia",
        "Artículo",
        "Académico",
        "Vinculación",
        "Logro",
        "Proyecto",
        "Evento",
        "Investigación"
      ],
      "required": true
    },
    "descripcion": {
      "type": "text",
      "required": true
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "enlace_boton": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  }
}
