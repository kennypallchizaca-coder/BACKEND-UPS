# ---------------------------------------------------------------------------
# .env.example -- Variables de entorno requeridas por el backend Strapi
# ---------------------------------------------------------------------------
# Copia este archivo como .env y reemplaza los valores de ejemplo.
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------------------

# Server
HOST=0.0.0.0
PORT=1337

# Secrets -- Genera valores unicos con: openssl rand -base64 24
APP_KEYS=clave-base64-1==,clave-base64-2==,clave-base64-3==,clave-base64-4==
API_TOKEN_SALT=genera-un-salt-unico-aqui==
ADMIN_JWT_SECRET=genera-un-jwt-secret-aqui==
TRANSFER_TOKEN_SALT=genera-un-transfer-salt-aqui==
ENCRYPTION_KEY=genera-una-encryption-key-aqui==
JWT_SECRET=genera-un-jwt-secret-aqui==

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=cambia-esta-password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_FILENAME=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# SMTP Configuration (para envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail
EMAIL_DEFAULT_FROM=tu-correo@gmail.com
EMAIL_DEFAULT_REPLY_TO=tu-correo@gmail.com

# CORS -- Origenes permitidos separados por coma (sin espacios)
# En desarrollo: http://localhost:5173,http://localhost:3000
# En produccion: https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telemetry
STRAPI_TELEMETRY_DISABLED=true
